# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: CHILEPASAJES / ENBUS GDS
# ==============================================================================
# Selector de entorno activo: "dev" (QA) o "prod" (Producción)
CHILEPASAJES_ENV="dev"
NEXT_PUBLIC_CHILEPASAJES_ENV="dev"

# ------------------------------------------------------------------------------
# 1. ENTORNO DE PRODUCCIÓN (PROD) - OFICIAL
# ------------------------------------------------------------------------------
CHILEPASAJES_PROD_API_KEY="sk_live_tu_api_key_de_produccion_aqui"
CHILEPASAJES_PROD_BASE_URL="https://back-prod.enbus.cl/api/v1"

# ------------------------------------------------------------------------------
# 2. ENTORNO DE PRUEBAS / QA (DEV)
# ------------------------------------------------------------------------------
CHILEPASAJES_DEV_API_KEY="sk_test_tu_api_key_de_pruebas_aqui"
CHILEPASAJES_DEV_BASE_URL="https://back-qas.enbus.cl/api/v1"

# ------------------------------------------------------------------------------
# VARIABLES ACTIVAS PRINCIPALES (Leídas por backend y Next.js)
# ------------------------------------------------------------------------------
CHILEPASAJES_API_KEY="sk_test_tu_api_key_de_pruebas_aqui"
CHILEPASAJES_BASE_URL="https://back-qas.enbus.cl/api/v1"

# Variables públicas para Frontend (Next.js)
NEXT_PUBLIC_CHILEPASAJES_BASE_URL="https://back-qas.enbus.cl/api/v1"
NEXT_PUBLIC_CHILEPASAJES_COMPLEMENT="pasajes"
NEXT_PUBLIC_CHILEPASAJES_DEVICE="P"
NEXT_PUBLIC_APP_NAME="Boletos.la"
NEXT_PUBLIC_DEFAULT_PHONE_PREFIX="+56"
NEXT_PUBLIC_HOLD_DURATION_MINUTES="15"
