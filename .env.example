# ==============================================================================
# INTEGRACIÓN API GDS ENBUS / CHILEPASAJES (NEXT.JS)
# ==============================================================================

# URL Base de la API REST de Enbus / Chilepasajes
NEXT_PUBLIC_CHILEPASAJES_BASE_URL="https://back-qas.enbus.cl/api/v1"

# API Key de autenticación (Token Bearer entregado por Chilepasajes)
NEXT_PUBLIC_CHILEPASAJES_API_KEY="sk_test_FtC48QXZHlbvE"

# Complemento de búsqueda para la plataforma (por defecto 'pasajes')
NEXT_PUBLIC_CHILEPASAJES_COMPLEMENT="pasajes"

# Tipo de dispositivo para reserva en GDS (P: Plataforma Web, M: Móvil, T: Tótem)
NEXT_PUBLIC_CHILEPASAJES_DEVICE="P"


# ==============================================================================
# CONFIGURACIÓN GENERAL DEL FRONTEND
# ==============================================================================

# Nombre de la aplicación visible en títulos y comprobantes
NEXT_PUBLIC_APP_NAME="Chilepasajes Sandbox"

# Prefijo telefónico por defecto para pasajeros y compradores (Chile: +56)
NEXT_PUBLIC_DEFAULT_PHONE_PREFIX="+56"

# Tiempo de retención de asientos en minutos (Hold TTL por defecto en Enbus: 15)
NEXT_PUBLIC_HOLD_DURATION_MINUTES="15"
